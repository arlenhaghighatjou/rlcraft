{
  "lellson/foodexpansion/DropHandler": {
    "name": "lellson/foodexpansion/DropHandler",
    "annotations": [
      {
        "type": "METHOD",
        "name": "Lnet/minecraftforge/fml/common/eventhandler/SubscribeEvent;",
        "target": "onEntityDrop(Lnet/minecraftforge/event/entity/living/LivingDropsEvent;)V"
      }
    ]
  },
  "lellson/foodexpansion/FoodExpansion": {
    "name": "lellson/foodexpansion/FoodExpansion",
    "annotations": [
      {
        "type": "CLASS",
        "name": "Lnet/minecraftforge/fml/common/Mod;",
        "target": "lellson/foodexpansion/FoodExpansion",
        "values": {
          "acceptedMinecraftVersions": {
            "value": "[1.12.2]"
          },
          "modid": {
            "value": "foodexpansion"
          },
          "name": {
            "value": "Food Expansion"
          },
          "version": {
            "value": "1.3"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/fml/common/SidedProxy;",
        "target": "proxy",
        "values": {
          "clientSide": {
            "value": "lellson.foodexpansion.proxy.ClientProxy"
          },
          "serverSide": {
            "value": "lellson.foodexpansion.proxy.CommonProxy"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/fml/common/Mod$Instance;",
        "target": "instance",
        "value": {
          "value": "foodexpansion"
        }
      },
      {
        "type": "METHOD",
        "name": "Lnet/minecraftforge/fml/common/Mod$EventHandler;",
        "target": "preInit(Lnet/minecraftforge/fml/common/event/FMLPreInitializationEvent;)V"
      },
      {
        "type": "METHOD",
        "name": "Lnet/minecraftforge/fml/common/eventhandler/SubscribeEvent;",
        "target": "onConfigChanged(Lnet/minecraftforge/fml/client/event/ConfigChangedEvent$OnConfigChangedEvent;)V"
      },
      {
        "type": "METHOD",
        "name": "Lnet/minecraftforge/fml/common/Mod$EventHandler;",
        "target": "init(Lnet/minecraftforge/fml/common/event/FMLInitializationEvent;)V"
      },
      {
        "type": "METHOD",
        "name": "Lnet/minecraftforge/fml/common/Mod$EventHandler;",
        "target": "postInit(Lnet/minecraftforge/fml/common/event/FMLPostInitializationEvent;)V"
      }
    ]
  },
