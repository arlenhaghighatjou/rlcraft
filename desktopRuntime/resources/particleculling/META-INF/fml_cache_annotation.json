  "bl4ckscor3/mod/particleculling/ParticleCulling$Configuration": {
    "name": "bl4ckscor3/mod/particleculling/ParticleCulling$Configuration",
    "annotations": [
      {
        "type": "CLASS",
        "name": "Lnet/minecraftforge/common/config/Config;",
        "target": "bl4ckscor3/mod/particleculling/ParticleCulling$Configuration",
        "values": {
          "modid": {
            "value": "particleculling"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "cullBehindBlocks",
        "value": {
          "values": [
            "Set this to false if you do not want to cull particles that technically are in the player\u0027s view but are obstructed by blocks."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "cullBehindGlass",
        "value": {
          "values": [
            "Set this to true if you don\u0027t want particles to be rendered behind glass and other transparent blocks. This does nothing if \"cullBehindBlocks\" is turned off."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "cullInSpectator",
        "value": {
          "values": [
            "Set this to false to disable particle culling while being in spectator mode. This is useful to take screenshots without having particles removed."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "blockBuffer",
        "value": {
          "values": [
            "The minimum amount of blocks behind which particles start to get culled. Only effective if \"cullBehindBlocks\" is turned on."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$RangeInt;",
        "target": "blockBuffer",
        "values": {
          "max": {
            "type": "INT",
            "value": "50"
          },
          "min": {
            "type": "INT",
            "value": "1"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "cullingEnabled",
        "value": {
          "values": [
            "Set this to false to disable all of particle culling\u0027s features."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "ignoredParticles",
        "value": {
          "values": [
            "Add particle classes here that should be ignored by Particle Culling.",
            "Example: To ignore Minecraft\u0027s breaking particles and any derivates, add \"net.minecraft.client.particle.ParticleBreaking\" to the list"
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Ignore;",
        "target": "ignoredParticleClasses"
      }
    ]
  },
