      {
        "type": "METHOD",
        "name": "Lnet/minecraftforge/fml/common/Mod$EventHandler;",
        "target": "onLoadComplete(Lnet/minecraftforge/fml/common/event/FMLLoadCompleteEvent;)V"
      },
      {
        "type": "METHOD",
        "name": "Lnet/minecraftforge/fml/common/Mod$EventHandler;",
        "target": "serverLoad(Lnet/minecraftforge/fml/common/event/FMLServerStartingEvent;)V"
