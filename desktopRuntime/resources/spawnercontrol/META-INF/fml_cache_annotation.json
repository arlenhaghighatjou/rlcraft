          "dependencies": {
            "value": "required-after:forge@[14.23.2.2596,);"
          },
          "guiFactory": {
            "value": "ladysnake.spawnercontrol.client.MSCConfigFactory"
          },
          "modid": {
            "value": "spawnercontrol"
          },
          "name": {
            "value": "Mob Spawner Control"
          },
          "version": {
            "value": "1.6.3b"
          }
