  "ladysnake/spawnercontrol/SpawnerEventHandler": {
    "name": "ladysnake/spawnercontrol/SpawnerEventHandler",
    "annotations": [
      {
        "type": "CLASS",
        "name": "Lnet/minecraftforge/fml/common/Mod$EventBusSubscriber;",
        "target": "ladysnake/spawnercontrol/SpawnerEventHandler",
        "values": {
          "modid": {
            "value": "spawnercontrol"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lcom/google/common/annotations/VisibleForTesting;",
        "target": "allSpawners"
      },
      {
        "type": "METHOD",
        "name": "Lnet/minecraftforge/fml/common/eventhandler/SubscribeEvent;",
        "target": "onAttachCapabilities(Lnet/minecraftforge/event/AttachCapabilitiesEvent;)V"
