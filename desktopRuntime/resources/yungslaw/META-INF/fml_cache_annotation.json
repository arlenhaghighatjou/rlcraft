      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "enableLiquidSafety",
        "value": {
          "values": [
            "If true, liquids such as water and lava will be considered Safe Blocks, meaning blocks close to them won\u0027t be replaced or deleted.\nRecommended: true"
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$RequiresWorldRestart;",
        "target": "enableLiquidSafety"
