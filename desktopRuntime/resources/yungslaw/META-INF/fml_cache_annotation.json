          "value": "Generation Distance"
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "genDistance",
        "value": {
          "values": [
            "If Ore Deletion Mode is disabled, this is the minimum distance from Safe Blocks (e.g. air) at which your Hard Block will replace underground blocks.\nIf Ore Deletion Mode is enabled, this is the minimum distance from Safe Blocks at which ores will start to be deleted."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$RequiresWorldRestart;",
