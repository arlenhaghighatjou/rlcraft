        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "tileSize",
        "value": {
          "values": [
            "The size (in GUI pixels) of a map\u0027s tile.",
            "Note that this will change with Minecraft\u0027s GUI scale configuration.",
            "When using a small gui scale, the map may look better with a TILE_SIZE of 16 or more."
          ]
