        "name": "Lnet/minecraftforge/common/config/Config$RangeInt;",
        "target": "markerSize",
        "values": {
          "min": {
            "type": "INT",
            "value": "0"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "playerIconWidth",
        "value": {
          "values": [
            "The width (in GUI pixels) of the player\u0027s icon."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$RangeInt;",
        "target": "playerIconWidth",
        "values": {
          "min": {
            "type": "INT",
            "value": "0"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "playerIconHeight",
        "value": {
          "values": [
            "The height (in GUI pixels) of the player\u0027s icon."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$RangeInt;",
        "target": "playerIconHeight",
        "values": {
          "min": {
            "type": "INT",
            "value": "0"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "borderX",
        "value": {
          "values": [
            "The width of the map border on the left and right sides of the minimap tiles.",
            "Represented as a fraction of the image width.",
            "Below a certain threshold, this border will be overtaken by the map border graphic."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$RangeDouble;",
        "target": "borderX",
        "values": {
          "max": {
            "type": "DOUBLE",
            "value": "0.5"
          },
          "min": {
            "type": "DOUBLE",
            "value": "0.0"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "borderY",
        "value": {
          "values": [
            "The width of the map border on the top and bottom sides of the minimap tiles.",
            "Represented as a fraction of the image width.",
            "Below a certain threshold, this border will be overtaken by the map border graphic.\n"
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$RangeDouble;",
        "target": "borderY",
        "values": {
          "max": {
            "type": "DOUBLE",
            "value": "0.5"
          },
          "min": {
            "type": "DOUBLE",
            "value": "0.0"
          }
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "requiresHold",
        "value": {
          "values": [
            "If true, the minimap will show the map of an atlas only while it is held.",
            "If false, the minimap will show the map of the first atlas in the hotbar."
          ]
        }
      },
      {
        "type": "FIELD",
        "name": "Lnet/minecraftforge/common/config/Config$Comment;",
        "target": "enabled",
        "value": {
          "values": [
            "Set true to enable minimap"
          ]
        }
      }
    ]
